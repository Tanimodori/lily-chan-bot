{
  "bot": {
    "login": "example-bot[bot]",
    "mention": "@example-bot"
  },
  "repos": {
    "owner/name": {
      "enabled": false,
      "code_repo": "owner/code",
      "code_ref_mode": "tag",
      "tag_template": "v{version}",
      "fallback_ref": "master",
      "reject": {
        "only": [
          "spam",
          "out_of_scope"
        ],
        "min_confidence": 0.9
      },
      "model_pool": "shared",
      "prompt_profile": "example",
      "extra_code_refs": [],
      "auxiliary_materials": [],
      "triage": {
        "process_only": [
          [
            "bug"
          ],
          [
            "needs triage"
          ]
        ],
        "write_only": [
          "crash",
          "scope: core",
          "needs info",
          "priority: high",
          "1.21.1"
        ],
        "label_axes": {
          "type": [
            "bug",
            "enhancement"
          ],
          "kind": [
            "crash"
          ],
          "scope": [
            "scope: core"
          ],
          "status": [
            "needs info"
          ],
          "priority": [
            "priority: high",
            "priority: low"
          ],
          "version": [
            "1.21.1"
          ]
        },
        "label_limits": {
          "type": 1,
          "kind": 2,
          "scope": 2,
          "status": 1,
          "priority": 1,
          "version": 1
        },
        "triage_labels": [
          "needs triage"
        ],
        "remove_after_triage": true
      }
    }
  }
}
